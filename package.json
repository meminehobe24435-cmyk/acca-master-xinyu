{
  "name": "acca-master",
  "version": "1.1.0",
  "private": true,
  "description": "⭐🐟 ACCA Master - ACCA 全科智能复习与刷题平台（单用户模式，打开即学）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "prisma generate && prisma db push && tsx scripts/seed.ts",
    "db:setup": "prisma generate && prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/seed.ts",
    "db:pg:prepare": "node scripts/prepare-postgres.mjs",
    "db:pg:generate": "npm run db:pg:prepare && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:pg:push": "npm run db:pg:prepare && prisma db push --schema prisma/schema.postgresql.prisma",
    "db:pg:seed": "npm run db:pg:generate && tsx scripts/seed.ts",
    "build:vercel": "node scripts/prepare-postgres.mjs && prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:interaction": "node scripts/interaction-qa.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@prisma/client": "6.4.1",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.15.0",
    "jose": "5.9.6",
    "katex": "0.16.21",
    "lucide-react": "0.475.0",
    "next": "15.2.4",
    "next-themes": "0.4.4",
    "papaparse": "5.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-markdown": "9.0.3",
    "recharts": "2.15.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "xlsx": "0.18.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/katex": "0.16.7",
    "@types/node": "22.13.5",
    "@types/papaparse": "5.3.15",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.2.4",
    "playwright": "^1.63.0",
    "postcss": "8.5.1",
    "prisma": "6.4.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
