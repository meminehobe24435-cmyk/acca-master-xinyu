# ===== ACCA Master ⭐🐟 - 环境变量模板 =====
# 复制为 .env 并填写。切勿将真实 Key / 口令提交到 git。

# --- 数据库 ---
# 本地默认 SQLite（零配置）。生产部署（Vercel/Netlify 等无持久磁盘）请使用 PostgreSQL / Neon：
# DATABASE_URL="postgresql://user:pass@host/acca_master?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- 会话与管理员口令 ---
# 签名密钥：生产环境请使用 32+ 位随机字符串（openssl rand -base64 48）
AUTH_SECRET="dev-only-change-me-please-32-characters-minimum!!"
# 管理后台口令（学习端无需登录；只有 /admin 需要）。至少 6 位。
ADMIN_PASSWORD="change-me-admin-password"
# 本地 HTTP 调试时设为 1 关闭 Secure Cookie；生产 HTTPS 请勿设置
# AUTH_INSECURE_COOKIE="1"

# --- AI Provider 抽象 ---
# AI_PROVIDER 可选: openai | deepseek | anthropic | gemini | openrouter | none
# 留空 / 不填 = AI 功能降级（网站核心功能不受影响，仅 AI Tutor / AI 生成不可用）
AI_PROVIDER=""

# OpenAI / OpenRouter / Gemini(openai-compat) 风格
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Gemini（OpenAI 兼容端点）
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-2.0-flash"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# --- 站点 ---
NEXT_PUBLIC_SITE_NAME="ACCA Master"
